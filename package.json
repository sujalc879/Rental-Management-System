{
  "name": "rental-management-system",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "overrides": { "minimatch": "11.0.1" },
  "trustedDependencies": ["@prisma/engines", "bun", "prisma"],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "worker": "bun apps/worker/src/index.ts",
    "backup": "bun scripts/backup/index.ts",
    "onboard": "bun scripts/onboard.ts",
    "seed:dev": "bun scripts/seed.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests *.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "build": "vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@hookform/resolvers": "7.0.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.106.0",
    "better-auth": "1.7.17",
    "bun": "1.4.4",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "hono": "4.13.16",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.69.0",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
