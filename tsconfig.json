{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "node", "vite/client"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["apps", "packages", "scripts", "tests", "*.ts"],
  "exclude": ["node_modules", "apps/web/dist"]
}
